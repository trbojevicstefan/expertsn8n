# Browser Firebase config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server runtime
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
SESSION_COOKIE_NAME=n8nexperts_session
SESSION_COOKIE_DAYS=5

# Set true only for local UI exploration. Never use in production.
DEMO_MODE=false
DEMO_ROLE=client

# Payment provider: mock | mangopay | stripe
PAYMENT_PROVIDER=mock
PLATFORM_FEE_BPS=1000

# Optional observability
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=

# Public app URL
NEXT_PUBLIC_APP_URL=https://n8nexperts.io
