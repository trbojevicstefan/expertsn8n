rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    // CV stays private to the expert and reviewers. A public copy is never made.
    match /private/experts/{uid}/cv/{fileName} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Photo is uploaded privately; only the server publishes a copy under public/.
    match /private/experts/{uid}/photo/{fileName} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Supporting documents an expert attaches to their profile: CVs, portfolios,
    // certificates and identity documents. Private to the expert and reviewers.
    match /private/experts/{uid}/documents/{kind}/{fileName} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid)
        && request.resource.size < 20 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          // HEIC is what an iPhone produces by default, so refusing it turned
          // a phone camera into a dead end. Accepted for documents, which are
          // downloaded rather than rendered in a page.
          || request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    // Files attached to a workflow showcase as evidence. Private to the expert
    // and reviewers: a showcase can carry client material.
    match /private/experts/{uid}/showcases/{showcaseId}/{fileName} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid) && request.resource.size < 25 * 1024 * 1024;
    }

    match /private/experts/{uid}/workflow-staging/{fileName} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid) && request.resource.size < 10 * 1024 * 1024;
    }

    // Server-written only. Approved profile photos live here.
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /private/contracts/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
